# ========================================
# CELESTRAL - Environment Configuration
# ========================================
# Copy this file to .env and fill in your values

# ========================================
# Server Configuration
# ========================================
PORT=5000
NODE_ENV=development

# ========================================
# CORS Configuration
# ========================================
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5500,http://127.0.0.1:5500

# ========================================
# Firebase Configuration
# ========================================
# Option 1: Use service account JSON file (recommended)
FIREBASE_SERVICE_ACCOUNT_PATH=./config/firebase-service-account.json

# Option 2: Use environment variables (alternative)
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_PRIVATE_KEY=your-private-key
# FIREBASE_CLIENT_EMAIL=your-client-email

# ========================================
# Authentication Configuration
# ========================================
# JWT secret for token generation (change in production!)
JWT_SECRET=celestral-secret-key-change-in-production

# ========================================
# OTP Configuration
# ========================================
# OTP expiry time in minutes
OTP_EXPIRY_MINUTES=5
